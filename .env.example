# Documentation template only; this file is not loaded automatically.
RESEARCH_DATA_DIR=./data
RESEARCH_MAX_UPLOAD_MB=50
RESEARCH_OCR_ENABLED=auto
RESEARCH_OCR_TESSDATA=./data/ocr/tessdata
RESEARCH_OCR_LANG=eng+chi_sim
# Optional local model prepared explicitly with scripts/prepare_semantic_model.py.
# Runtime never downloads model files. start.ps1 enables this when prepared.
RESEARCH_SEMANTIC_ENABLED=auto
# Alternatively use the local model-settings dialog; never commit real keys.
RESEARCH_MODEL_BASE_URL=https://api.deepseek.com
RESEARCH_MODEL=deepseek-flash
RESEARCH_MODEL_API_KEY=
